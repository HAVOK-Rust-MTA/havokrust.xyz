LOOT_BOXES = {'default-barrel', 'industrial-barrel', 'flammable-barrel', 'default-box', 'military-box', 'military-barrel'}
PIECES = {'Fundação': 'foundation', 'Fundação Triangular': 'foundation-triangular', 'Meia Fundação': 'foundation-div',
          'Parede': 'wall', 'Meia Parede': 'wall-div', 'Parede para Porta': 'wallport', 'Janela': 'window',
          'Escadas': 'stairs', 'Portão': 'gate', 'Porta': 'door', 'Teto': 'ceiling', 'Meio Teto': 'ceiling-div',
          'Teto Triangular': 'ceiling-triangular', 'Floorport': 'ceiling-stairs'}


    warn('não achei o pacote do oficial em %s: nada vai receber "em breve" automático' % args.deploy)

SOON = T.get('soon', {})
soon_items = set(SOON.get('items', []))


def icon_is_local_only(icon):
    if not icon or not official_img:
        return False
    if icon.startswith(':'):
        res = icon[1:].split('/')[0]
        return res in local_only_res
    return icon not in official_img and icon.replace(' ', '_') not in official_img


# ------------------------------------------------------------------ 3. ajudas
def slug(s):
    s = unicodedata.normalize('NFKD', s).encode('ascii', 'ignore').decode()
    return re.sub(r'[^a-z0-9]+', '-', s.lower()).strip('-')


ITEMS = G['items']
OBJS = G['objects']
TR = G['translations']
TI = T['items']
CLOTHES = G['clothes']

MENU = {}  # item -> categoria do menu de blueprints
for cat in G['blueprints']:
    for k in cat['items']:
        MENU[k] = cat['category']

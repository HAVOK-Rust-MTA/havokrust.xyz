cos_slug = {k: slug((c.get('name') or {}).get('en') or k) for k, c in CLOTHES.items()}


def ref(name, qty=None):
    """item do jogo -> {id, qty} (aceita 'Item:BLUEPRINT' e roupas do personagem)"""
    out = {}
    if name.endswith(':BLUEPRINT'):
        base = name[:-len(':BLUEPRINT')]
        if base in id_of:
            out = {'id': id_of[base], 'bp': True}
    elif name in id_of:
        out = {'id': id_of[name]}
    elif name in CLOTHES:
        out = {'cosmetic': cos_slug[name]}
    if not out:
        warn('item desconhecido nas configs: %r' % name)
        out = {'name': name}
    if qty is not None:
        out['qty'] = qty
    return out


def cost(lst):
    rec, lvl = [], None
    for name, n in (lst or []):
        if name == 'Level':
            lvl = n
        else:
            r = ref(name, n)
            if 'id' in r:
                rec.append({'id': r['id'], 'qty': n})
    return rec, lvl


# ------------------------------------------------------------------ 4. de onde sai cada item
sources = {}       # chave -> [fonte]
bp_sources = {}    # chave -> [fonte] (blueprint que cai pronta)


def add_src(item, src):
    if item.endswith(':BLUEPRINT'):
        base = item[:-len(':BLUEPRINT')]
        bp_sources.setdefault(base, [])
        if src not in bp_sources[base]:
            bp_sources[base].append(src)
        return
    sources.setdefault(item, [])
    if src not in sources[item]:
        sources[item].append(src)


for box in ['default-barrel', 'industrial-barrel', 'flammable-barrel', 'default-box', 'military-box', 'military-barrel']:
    for e in (G['loot'] or {}).get(box, []):
        if e[1] and e[1] > 0:
            add_src(e[0], box)
for e in (G['helicopter'] or []):
    if e[1] and e[1] > 0:
        add_src(e[0], 'helicopter')
for e in (G['airdrop'].get('loot') or []):
    if e[1] and e[1] > 0:
        add_src(e[0], 'airdrop')
for e in (G['hospital'].get('loot') or []):
    add_src(e[0], 'hospital')
FARM_SRC = {'Tree': 'tree', 'Stone': 'rock', 'Iron': 'iron-rock', 'Sulphur': 'sulfur-rock'}
for kind, f in G['farms'].items():
    for it in f['items']:
        add_src(it, FARM_SRC.get(kind, kind.lower()))
for name in list(sources) + list(bp_sources):
    if name not in ITEMS and name not in OBJS and name not in CLOTHES:
        warn('item que não existe no jogo numa tabela de loot: %r (erro de digitação na config?)' % name)
        sources.pop(name, None)
        bp_sources.pop(name, None)
SRC_ORDER = ['tree', 'rock', 'iron-rock', 'sulfur-rock', 'planter', 'fill', 'cook', 'default-barrel', 'industrial-barrel',
             'flammable-barrel', 'default-box', 'military-box', 'military-barrel', 'hospital', 'helicopter', 'airdrop']


def order_src(lst):
    return sorted(set(lst), key=lambda s: SRC_ORDER.index(s) if s in SRC_ORDER else 99)


# loja
shop_of = {}
shop_cats = []
SHOP_CAT = T.get('shopCategories', {})
for cat in G['shop'] or []:
    cid = slug(cat['Categoria'])
    entries = []
    for it in cat['Itens']:
        r = ref(it['Nome'])
        e = dict(r, price=it['Valor'], qty=it['Quantidade'])
        if it.get('Roupa'):
            e['tier'] = it.get('Tier')
        entries.append(e)
        if it['Nome'] in id_of:
            shop_of[it['Nome']] = {'price': it['Valor'], 'qty': it['Quantidade'], 'cat': cid}
    shop_cats.append({'id': cid, 'name': SHOP_CAT.get(cid, {'en': cat['Categoria'].title(), 'pt': cat['Categoria'].title()}),
                      'items': entries})

# missões
missions = []
reward_of = {}
bp_reward_of = {}
need_of = {}
MT = T.get('missions', {})
for idx, m in enumerate(G['missions']['list'] or [], 1):
    mt = MT.get(str(idx), {})
    name_pt = re.sub(r'^\[Lvl \d+\]\s*', '', m.get('name', ''))
    req = [ref(k, v) for k, v in sorted((m.get('requiredItems') or {}).items())]
    rew = [ref(k, v) for k, v in sorted((m.get('rewardItems') or {}).items())]
    missions.append({'id': idx, 'name': {'pt': mt.get('pt', name_pt), 'en': mt.get('en', name_pt)},
                     'level': m.get('levelRequired') or None, 'xp': m.get('xpBonus', 0),
                     'disabled': bool(m.get('Disabled')), 'requires': req, 'rewards': rew})
    if not m.get('Disabled'):
        for k in (m.get('rewardItems') or {}):
            if k.endswith(':BLUEPRINT'):
                bp_reward_of.setdefault(k[:-len(':BLUEPRINT')], []).append(idx)
            else:
                reward_of.setdefault(k, []).append(idx)
        for k in (m.get('requiredItems') or {}):
            need_of.setdefault(k, []).append(idx)

# ------------------------------------------------------------------ 5. ícones
ICON_DIR = os.path.join(SITE, 'icons')


def game_icon_path(icon):
    if not icon:
        return None
    if icon.startswith(':'):
        res, rest = icon[1:].split('/', 1)
        cands = [os.path.join(DEP, res, rest)]
    else:
        cands = [os.path.join(GM_IMG, icon), os.path.join(GM_IMG, icon.replace(' ', '_'))]
    for c in cands:
        if os.path.isfile(c):
            return c
    return None


def copy_icon(src, dst):
    if args.check:
        return
    try:
        from PIL import Image
        im = Image.open(src).convert('RGBA')
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        # paleta de 256 cores com transparência (igual aos ícones antigos): ~1/3 do tamanho, sem diferença a 128 px
        im = im.quantize(colors=256, method=Image.Quantize.FASTOCTREE)
        im.save(dst, optimize=True)
    except ImportError:
        shutil.copyfile(src, dst)


def wiki_icon(key, iid, game_icon):
    rel = 'icons/%s.png' % iid
    if os.path.isfile(os.path.join(SITE, rel)):
        return rel
    if (TI.get(key) or {}).get('icon') is False:
        return None
    src = game_icon_path(game_icon)
    if src:
        copy_icon(src, os.path.join(SITE, rel))
        report['icons_copied'].append('%s <- %s' % (rel, os.path.relpath(src, args.havok)))
        return rel
    report['icons_missing'].append(key)
    return None


# ------------------------------------------------------------------ 6. itens
SPEED = lambda s: 'fast' if s <= 20 else 'medium' if s <= 40 else 'slow' if s <= 100 else 'very-slow'


def limit_text(lim):
    if lim is None:
        return None
    if isinstance(lim, (int, float)):
        return {'en': str(int(lim)), 'pt': str(int(lim))}
    a = lim[0]
    # a cada quantos levels sobe e quanto
    step = None
    for every in (2, 4, 20):
        if len(lim) > every and lim[every - 1] > a and all(lim[i] == lim[i - 1] for i in range(1, every - 1)):
            step = every
            break
    if not step:
        return {'en': str(a), 'pt': str(a)}
    inc = lim[step - 1] - a
    return {'en': '%d + %d every %d levels' % (a, inc, step), 'pt': '%d + %d a cada %d níveis' % (a, inc, step)}


items = []
by_key = {}
for key in KEYS:
    iid = id_of[key]
    cur = TI.get(key, {})
    gi = ITEMS.get(key)
    ob = OBJS.get(key)
    tr = TR.get(key) or {}
    name = cur.get('name') or tr.get('name') or {'en': key, 'pt': key}
    desc = cur.get('desc') or tr.get('desc') or {'en': '', 'pt': ''}
    it = {'id': iid, 'key': key, 'cat': cur.get('cat') or 'components', 'type': cur.get('type') or 'Item',
          'name': {'en': name.get('en') or key, 'pt': name.get('pt') or name.get('en') or key},
          'desc': {'en': desc.get('en') or '', 'pt': desc.get('pt') or desc.get('en') or ''}}
    if not cur:
        warn('sem texto curado em wiki-texts.json: %s (usei o do jogo)' % key)
    if ob and ob.get('baseItem'):
        it['piece'] = PIECES_CI.get((ob.get('Type') or '').lower())
        if not it['piece']:
            warn('tipo de peça desconhecido: %s (%s)' % (ob.get('Type'), key))
        # material pelo nome (o objLevel do jogo tem erro em algumas peças)
        tier = next((i for i, m in enumerate(TIER_WORDS) if m in key.lower()), ob.get('objLevel'))
        it['tier'] = tier
        it['icon'] = None
        rec, lvl = cost(ob.get('craftingCusto'))
        it['recipe'] = rec
        it['level'] = lvl
        it['hp'] = ob.get('maxHealth')
        evo = ob.get('evolutionTo')
        if evo:
            it['upgradeTo'] = id_of.get(evo[0] if isinstance(evo, list) else evo)
    elif ob:
        it['icon'] = wiki_icon(key, iid, ob.get('icon'))
        it['stack'] = None
        if key in MENU:
            rec, lvl = cost(ob.get('craftingCusto'))
            it['recipe'] = rec
            it['level'] = lvl
            it['bench'] = False
        it['hp'] = ob.get('maxHealth')
        if ob.get('maxSlots'):
            it['slots'] = ob['maxSlots']
        lim = limit_text(ob.get('limit') if ob.get('limit') is not None else ob.get('limitByLevel'))
        if key == 'Cama':
            lim = {'en': '1 (VIP: 2 to 4)', 'pt': '1 (VIP: 2 a 4)'}
        if lim:
            it['limit'] = lim
        evo = ob.get('evolutionTo')
        if isinstance(evo, str):
            it['upgradeTo'] = id_of.get(evo)
    else:
        it['icon'] = wiki_icon(key, iid, gi.get('icon'))
        it['stack'] = gi.get('maxStack')
        if key in MENU:
            rec, lvl = cost(gi.get('craft'))
            it['recipe'] = rec
            it['level'] = lvl
            it['bench'] = MENU[key] in BENCH_CATS
            if (key + ':BLUEPRINT') in ITEMS:
                it['blueprint'] = gi.get('research') or 0
        w = gi.get('weapon')
        if w and w.get('damage'):
            # dano em %% do sangue máximo (15 000) por acerto; explosivo de arremesso (dano gigante) fica sem número
            dmg = w['damage']
            am = gi.get('ammo') or {}
            it['weapon'] = {'damage': round(dmg / 150) if dmg < 50000 else None, 'range': w['distance'],
                            'mag': am.get('magSize'), 'ammo': id_of.get(am.get('name'))}
        if gi.get('recycler'):
            it['recycler'] = [r for r in (ref(n, q) for n, q in gi['recycler']) if 'id' in r]
        if gi.get('receive') and gi['receive'] > 1 and it.get('recipe') is not None:
            it['receive'] = gi['receive']
        # armas que usam esta munição (lido da própria arma, não do texto 'ammoTo')
        users = [k2 for k2 in TI if k2 in ITEMS and (ITEMS[k2].get('ammo') or {}).get('name') == key]
        users += sorted(k2 for k2 in ITEMS if (ITEMS[k2].get('ammo') or {}).get('name') == key and k2 not in users)
        if users:
            it['ammoFor'] = [id_of[x] for x in users if x in id_of]
        f = gi.get('furnace')
        if f and f.get('receive'):
            it['furnace'] = {'to': id_of.get(f['receive'][0]), 'speed': SPEED(f.get('speed') or 0)}
        if gi.get('equipSlot'):
            it['equip'] = gi['equipSlot']
        if gi.get('backpackBonus'):
            it['bonus'] = gi['backpackBonus']
        if gi.get('durability'):
            it['durability'] = gi['durability']
    src = (sources.get(key) or []) + (cur.get('sources') or [])
    if src:
        it['sources'] = order_src(src)
    if bp_sources.get(key):
        it['bpSources'] = order_src(bp_sources[key])
    if key in shop_of:
        it['shop'] = shop_of[key]
    if reward_of.get(key):
        it['rewardOf'] = reward_of[key]
    if bp_reward_of.get(key):
        it['bpRewardOf'] = bp_reward_of[key]
    if need_of.get(key):
        it['neededBy'] = need_of[key]
    soon = key in soon_items or icon_is_local_only((gi or ob or {}).get('icon'))
    if soon:
        it['soon'] = True
    if cur.get('note'):
        it['note'] = cur['note']
    items.append(it)
    by_key[key] = it


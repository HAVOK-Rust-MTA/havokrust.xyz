# Scripts do oficial vão compilados/cifrados (não dá nem se deve ler). A comparação usa o que é aberto:
#  - quais resources existem no pacote do HeavyHost (deathmatch/ + atualizacao-*/LISTA.txt);
#  - quais imagens de item existem no gamemode que subiu;
#  - a lista manual T['soon'] (o que mudou dentro de scripts e ainda não subiu).
official_res = set()
official_img = set()
mirror = os.path.join(args.deploy, 'deathmatch/resources/[HAVOK]')
for sub in ['[dependencies]', '[dependencies]/[havok_maps]']:
    d = os.path.join(mirror, sub)
    if os.path.isdir(d):
        official_res.update(os.listdir(d))
for lista in glob.glob(os.path.join(glob.escape(args.deploy), 'atualizacao-*', 'LISTA.txt')):
    for line in open(lista, encoding='utf-8'):
        line = line.strip().rstrip('/')
        if line:
            official_res.add(line.split('/')[-1])
for base in [mirror] + sorted(glob.glob(os.path.join(glob.escape(args.deploy), 'atualizacao-*', 'resources', '[[]HAVOK]'))):
    imgdir = os.path.join(base, 'gamemode/files/images')
    for dp, _, fs in os.walk(imgdir):

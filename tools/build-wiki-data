#!/usr/bin/env python3
"""Gera o data.js da wiki a partir do código do jogo (HAVOK, MTA) + tools/wiki-texts.json.

    tools/build-wiki-data                 # lê ~/MTA-Server, escreve data.js e copia ícones novos para icons/
    tools/build-wiki-data --check         # só confere (não escreve nada) e lista o que mudou/falta
    tools/build-wiki-data --havok <pasta [HAVOK]> --deploy <pasta build/deploy-heavyhost>

Precisa de: python3, lua5.1 (ou luajit) e Pillow (para copiar os ícones). Ver tools/WIKI-DATA.md.
Os números (receitas, dano, pilha, loot, loja, missões, veículos...) vêm SEMPRE do jogo; os textos (nomes, descrições,
guias, FAQ) vêm do wiki-texts.json. Nada do anticheat/staff é lido nem publicado.
"""
import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata

HERE = os.path.dirname(os.path.abspath(__file__))
SITE = os.path.dirname(HERE)
HOME = os.path.expanduser('~')
DEF_HAVOK = os.path.join(HOME, 'MTA-Server/mods/deathmatch/resources/[HAVOK]')
DEF_DEPLOY = os.path.join(HOME, 'MTA-Server/build/deploy-heavyhost')

ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
ap.add_argument('--havok', default=DEF_HAVOK, help='pasta resources/[HAVOK] do servidor local')
ap.add_argument('--deploy', default=DEF_DEPLOY, help='pasta build/deploy-heavyhost (o que já subiu para o oficial)')
ap.add_argument('--texts', default=os.path.join(HERE, 'wiki-texts.json'))
ap.add_argument('--out', default=os.path.join(SITE, 'data.js'))
ap.add_argument('--check', action='store_true', help='não escreve nada')
args = ap.parse_args()

report = {'warn': [], 'icons_copied': [], 'icons_missing': [], 'new_items': []}


def warn(msg):
    report['warn'].append(msg)


# ------------------------------------------------------------------ 1. lê o jogo (Lua)
def run_dump():
    lua = shutil.which('lua5.1') or shutil.which('luajit') or shutil.which('lua')
    if not lua:
        sys.exit('preciso do lua5.1 (ou luajit) no PATH')
    r = subprocess.run([lua, os.path.join(HERE, 'wiki-dump.lua'), args.havok], capture_output=True)
    if r.returncode != 0:
        sys.exit('wiki-dump.lua falhou:\n' + r.stderr.decode(errors='replace'))
    d = json.loads(r.stdout.decode('utf-8'))
    for w in (d.get('warnings') or []):
        warn('lua: ' + w)
    return d


G = run_dump()
T = json.load(open(args.texts, encoding='utf-8'))
DEP = os.path.join(args.havok, '[dependencies]')
GM_IMG = os.path.join(args.havok, 'gamemode/files/images')

# configs simples do servidor (só as chaves públicas; o arquivo tem senha, que NÃO entra)
SETTINGS_PUBLIC = ['Minutos a cada airdrop', 'Minutos a cada heli atirador', 'horas decay', 'Dano Decay',
                   'Minutos para nascer na cama', 'Minutos para respawnar farm', 'Minutos para respawnar veiculos',
                   'Limite de itens no mesmo spawn']
settings = {}
try:
    raw = json.load(open(os.path.join(DEP, 'havok_settings/serverSettings.json'), encoding='utf-8'))
    raw = raw[0] if isinstance(raw, list) else raw
    settings = {k: raw[k] for k in SETTINGS_PUBLIC if k in raw}
except Exception as e:  # noqa
    warn('serverSettings.json: %s' % e)


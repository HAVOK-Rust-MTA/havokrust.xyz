items.sort(key=lambda it: (CAT_ORDER.index(it['cat']) if it['cat'] in CAT_ORDER else 99, order.get(it['key'], 9999)))

# ------------------------------------------------------------------ 7. cosméticos (roupas do personagem + mochilas)
COS_CATS = [('shirts', 'torso'), ('pants', 'legs'), ('shoes', 'feet'), ('caps', 'head'), ('masks', 'mask'),
            ('glasses', 'glasses')]
